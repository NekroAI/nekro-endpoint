{
  "name": "nekro-endpoint",
  "version": "1.0.0",
  "description": "Endpoint Orchestration Platform - Build and manage your API endpoints at the edge",
  "private": true,
  "packageManager": "pnpm@10.11.1",
  "scripts": {
    "dev": "concurrently \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:backend": "wrangler dev",
    "dev:frontend": "vite --config frontend/vite.config.mts",
    "build:client": "vite build --config frontend/vite.config.mts",
    "build:server": "vite build --ssr src/entry-server.tsx --outDir ../dist/server --config frontend/vite.config.mts",
    "build": "pnpm generate:html && pnpm build:client && pnpm build:server",
    "build:prod": "pnpm db:migrate:prod && pnpm generate:html && pnpm build:client && pnpm build:server",
    "generate:html": "tsx scripts/generateHtml.ts",
    "deploy": "pnpm build && wrangler deploy --env production",
    "serve:prod": "pnpm build && wrangler dev --env production",
    "test": "vitest",
    "test:ci": "vitest run && vitest run -c vitest.contract.config.ts",
    "test:contract": "vitest run -c vitest.contract.config.ts",
    "ep": "python3 scripts/epctl.py",
    "cf-typegen": "wrangler types",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "wrangler d1 migrations apply DB --local",
    "db:migrate:prod": "wrangler d1 migrations apply DB --env production --remote",
    "db:studio": "drizzle-kit studio",
    "db:check": "drizzle-kit check",
    "db:seed": "wrangler d1 execute DB --local --file=./drizzle/seed.sql",
    "db:seed:prod": "wrangler d1 execute DB --remote --file=./drizzle/seed.sql",
    "typecheck": "tsc --noEmit",
    "lint": "tsx",
    "format": "eslint . --fix",
    "test:cli": "python3 -m unittest discover -s scripts -p 'test_epctl.py'"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "^0.7.5",
    "@cloudflare/workers-types": "^4.20250320.0",
    "@hono/vite-cloudflare-pages": "^0.4.2",
    "@types/d3-hierarchy": "^3.1.7",
    "@types/node": "^20.14.9",
    "@types/pngjs": "^6.0.5",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "@vitejs/plugin-react-swc": "^3.10.2",
    "concurrently": "^8.2.2",
    "drizzle-kit": "^0.31.4",
    "jsqr": "^1.4.0",
    "pngjs": "^7.0.0",
    "prettier": "^3.3.2",
    "rimraf": "^5.0.7",
    "tsx": "^4.20.3",
    "typescript": "^5.5.2",
    "vite": "^5.3.1",
    "vitest": "~3.0.7",
    "wrangler": "^4.30.0"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
    "@emotion/styled": "^11.14.1",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@hono/swagger-ui": "^0.5.1",
    "@hono/zod-openapi": "0.18.0",
    "@monaco-editor/react": "^4.7.0",
    "@mui/icons-material": "^5.17.1",
    "@mui/material": "^5.17.1",
    "@mui/system": "^7.1.1",
    "@mui/x-tree-view": "^8.16.0",
    "@paralleldrive/cuid2": "^2.2.2",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query": "^5.81.2",
    "@xyflow/react": "^12.12.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "d3-hierarchy": "^3.1.2",
    "drizzle-orm": "^0.44.2",
    "drizzle-zod": "^0.8.2",
    "framer-motion": "^12.23.0",
    "hono": "4.4.0",
    "i18next": "^25.2.1",
    "i18next-browser-languagedetector": "^8.2.0",
    "lucide-react": "^1.49.0",
    "motion": "^13.4.6",
    "qrcode": "1.5.4",
    "radix-ui": "^1.6.7",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^15.5.3",
    "react-router-dom": "6.23.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "uuid": "^13.0.0",
    "zod": "^3.22.4"
  }
}
